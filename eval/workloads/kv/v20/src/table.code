public struct Entry {
    public key: i64,
    public val: i64,
    public state: i64,
    public exp: i64,
}

// state: 1 = empty, 2 = full, 3 = tombstone
public class Table {
    public cap: i64,
    public mask: i64,
    public tomb: i64,
    public used: i64,
    public slots: [Entry],
}

func blank() -> Entry {
    Entry { key: 0, val: 0, state: 1, exp: 0 }
}

public func table_new() -> Table {
    Table {
        cap: 128,
        mask: 127,
        tomb: 0,
        used: 0,
        slots: [blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank(), blank()],
    }
}

@realtime
func mix(key: i64) -> i64
    ensures result >= 0
{
    ((key * 40503) ^ (key >> 9)) & 2147483647
}

@realtime
func slot_of(key: i64, mask: i64) -> i64
    requires mask >= 0
    ensures result >= 0 && result <= mask
{
    mix(key) & mask
}

@realtime
func next_slot(i: i64, mask: i64) -> i64
    requires mask >= 0
    ensures result >= 0 && result <= mask
{
    (i + 1) & mask
}

@noalloc
func find_slot(t: Table, key: i64) -> i64 {
    let mask = t.mask
    if mask < 0 { return -1 }
    var i = slot_of(key, mask)
    var n = 0
    while n < t.cap {
        let s = t.slots[i].state
        if s == 1 { return -1 }
        if s == 2 && t.slots[i].key == key { return i }
        i = next_slot(i, mask)
        n += 1
    }
    -1
}

public func table_get(t: Table, key: i64, now: i64) -> i64? {
    let at = find_slot(t, key)
    if at < 0 { return nil }
    let e = t.slots[at].exp
    if e != 0 && e <= now { return nil }
    t.slots[at].val
}

@noalloc
public func table_expire(t: Table, key: i64, at_time: i64) -> bool {
    let at = find_slot(t, key)
    if at < 0 { return false }
    t.slots[at].exp = at_time
    true
}

@noalloc
public func table_put(t: Table, key: i64, val: i64) -> bool {
    let at = find_slot(t, key)
    if at >= 0 {
        t.slots[at].val = val
        return true
    }
    if t.used + t.tomb + 1 > t.cap { return false }
    let mask = t.mask
    if mask < 0 { return false }
    var i = slot_of(key, mask)
    while t.slots[i].state == 2 {
        i = next_slot(i, mask)
    }
    if t.slots[i].state == 3 { t.tomb -= 1 }
    t.slots[i].key = key
    t.slots[i].val = val
    t.slots[i].state = 2
    t.used += 1
    true
}

@noalloc
public func table_del(t: Table, key: i64) -> bool {
    let at = find_slot(t, key)
    if at < 0 { return false }
    t.slots[at].state = 3
    t.tomb += 1
    t.used -= 1
    true
}

@noalloc
public func table_del_range(t: Table, lo: i64, hi: i64) -> i64 {
    var removed = 0
    for i in 0..t.cap {
        if t.slots[i].state == 2 {
            let k = t.slots[i].key
            if k >= lo && k <= hi {
                t.slots[i].state = 3
                t.tomb += 1
                t.used -= 1
                removed += 1
            }
        }
    }
    removed
}

@noalloc
public func table_scan(t: Table, lo: i64, hi: i64) -> i64 {
    if t.used == 0 { return 0 }
    var sum = 0
    for i in 0..t.cap {
        if t.slots[i].state == 2 {
            let k = t.slots[i].key
            if k >= lo && k <= hi {
                sum += t.slots[i].val
            }
        }
    }
    sum
}

@noalloc
public func table_count(t: Table) -> i64 {
    t.used
}
