// Functionality:
// - The smallest program that does something you can see. Run it with
//   `codira run --manifest-path examples/hello/codira.toml`.

func square(x: i64) -> i64 {
    x * x
}

public func main() {
    println("Hello, world!")

    var i: i64 = 1
    while i <= 3 {
        println(i, " squared is ", square(i))
        i += 1
    }

    println("pi is roughly ", 3.14159, ", and that is ", true)
}
