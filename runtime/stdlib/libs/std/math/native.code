package std.math

@FastNative
foreign func CODE_CORE_FastPowerDoubleInt64(x: Float64, y: Int64): Float64

/**
 * libc functions wrapper functions.
 * these wrappers are mainly used to avoid name 'pollution' to the current namespace.
 * for now, native functions can only reside in top level, thus can not be put into a namespace construct
 */
@FastNative
foreign func CODE_MATH_Tan(x: Float64): Float64

@FastNative
foreign func CODE_MATH_Tanf(x: Float32): Float32

@FastNative
foreign func CODE_MATH_Asin(x: Float64): Float64

@FastNative
foreign func CODE_MATH_Asinf(x: Float32): Float32

@FastNative
foreign func CODE_MATH_Acos(x: Float64): Float64

@FastNative
foreign func CODE_MATH_Acosf(x: Float32): Float32

@FastNative
foreign func CODE_MATH_Atan(x: Float64): Float64

@FastNative
foreign func CODE_MATH_Atanf(x: Float32): Float32

@FastNative
foreign func CODE_MATH_Atan2(y: Float64, x: Float64): Float64

@FastNative
foreign func CODE_MATH_Atan2f(y: Float32, x: Float32): Float32

@FastNative
foreign func CODE_MATH_Sinh(x: Float64): Float64

@FastNative
foreign func CODE_MATH_Sinhf(x: Float32): Float32

@FastNative
foreign func CODE_MATH_Cosh(x: Float64): Float64

