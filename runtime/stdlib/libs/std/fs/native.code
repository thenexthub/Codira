/**
 * @file
 *
 * This file defines native functions.
 */

package std.fs

foreign {
    // Path
    func CODE_FS_NormalizePath(path: CString, realPath: CPointer<UInt8>): CPointer<FsError> // (<= 0): error, (> 0): real path size

    // FileInfo
    func CODE_FS_PathSize(path: CString): Int64 // -1: failed, (>= 0): file size
    func CODE_FS_GetCreationTime(path: CString): Int64 // -1: failed, (>= 0): time data
    func CODE_FS_GetLastAccessTime(path: CString): Int64 // -1: failed, (>= 0): time data
    func CODE_FS_GetLastModificationTime(path: CString): Int64 // -1: failed, (>= 0): time data

    func CODE_FS_IsReadOnly(path: CString): Int8 // -1: error, 0: false, 1: true

    func CODE_FS_CanRead(path: CString): Int8 // -1: error, 0: false, 1: true
    func CODE_FS_CanWrite(path: CString): Int8 // -1: error, 0: false, 1: true
    func CODE_FS_CanExecute(path: CString): Int8 // -1: error, 0: false, 1: true

    func CODE_FS_SetExecutable(path: CString, executable: Bool): Int8 // -2: Operation not permitted, -1: Other Errors, 0: false, 1: true
    func CODE_FS_SetReadable(path: CString, readable: Bool): Int8 // -2: Operation not permitted, -1: Other Errors, 0: false, 1: true
    func CODE_FS_SetWritable(path: CString, writable: Bool): Int8 // -2: Operation not permitted, -1: Other Errors, 0: false, 1: true

    // Directory
    func CODE_FS_ISDirEmpty(path: CString): Int8 // -1: error, 0: false, 1: true
    func CODE_FS_DirCreate(path: CString): CPointer<FsError> // false: errCode < 0, true: errCode == 0
    func CODE_FS_DirCreateRecursive(path: CString): CPointer<FsError> // false: errCode < 0, true: errCode == 0
    func CODE_FS_CreateTempDir(path: CPointer<Byte>): Bool // false: Failed, true: Success
    func CODE_FS_CopyREF(srcPath: CString, destPath: CString): Int8 // -1: failed, 0: success
    func CODE_FS_CopyLink(srcPath: CString, destPath: CString): Int8 // -1: failed, 0: success
    func CODE_FS_GetDirHandleAndFirstFile(path: CString, hd: CPointer<UIntNative>): CString
    func CODE_FS_ReadDirHandle(hd: UIntNative): CString
    func CODE_FS_CloseDirHandle(hd: UIntNative): Unit

    // File
    func CODE_FS_OpenFile(path: CString, openMode: Int32): CPointer<FsInfo>
    func CODE_FS_Seek(fd: FileHandle, whence: Int32, offset: Int64): Int64 // -1: failed, (>= 0): distance from the start position
    func CODE_FS_CloseFile(fd: FileHandle): Int64 // -1: failed, (>= 0): success
    func CODE_FS_GetFileSize(fd: FileHandle): Int64 // -1: failed, (>= 0): file size
    func CODE_FS_FileRead(fd: FileHandle, buffer: CPointer<Byte>, maxLen: UIntNative): Int64 // -1: failed, 0: end, (>0): the size of buffer be read
    func CODE_FS_FileWrite(fd: FileHandle, buffer: CPointer<Byte>, maxLen: UIntNative): Bool // -1: failed, (>=0): the size of buffer be written
    func CODE_FS_Truncate(fd: FileHandle, length: Int64): CPointer<FsError>

    func CODE_FS_CreateTempFile(path: CPointer<Byte>): FileHandle

    // Util
    func CODE_FS_IsLink(path: CString): Int8 // -1: error, 0: false, 1: true
    func CODE_FS_IsFile(path: CString): Int8 // -1: error, 0: false, 1: true
    func CODE_FS_IsDir(path: CString): Int8 // -1: error, 0: false, 1: true

    func CODE_FS_IsFileORLinkToFile(path: CString): Int8 // -1: error, 0: false, 1: true
    func CODE_FS_IsDirORLinkToFDir(path: CString): Int8 // -1: error, 0: false, 1: true

    func CODE_FS_Exists(path: CString): Int8 //0: true
    func CODE_FS_Remove(path: CString, recursive: Bool): CPointer<FsError> // false: errCode < 0, true: errCode == 0
    func CODE_FS_Rename(sourcePath: CString, destinationPath: CString): CPointer<FsError> // false: errCode < 0, true: errCode == 0

    func CODE_FS_ErrnoGet(): Int32 // get errno
    func CODE_FS_FormatMessage(errnoValue: Int32): CString // get error message on windows
    func CODE_FS_ErrmesGet(errnoValue: Int32): CString // get message for the current errno

    func CODE_FS_Link(linkPath: CString, originPath: CString): CPointer<FsError>
    func CODE_FS_SymLink(linkPath: CString, originPath: CString): CPointer<FsError>
    func CODE_FS_ReadLink(path: CString): CPointer<FsError> // false errcode < 0, true: errcode == 0, errmsg is path
}

/**
 * If the c function succeeds, the rtnCode is zero and the msg is a null pointer.
 * If the c function fails, the rtnCode is less than zero and the msg is a cstring.
 */
@C
struct FsError {
    let rtnCode: Int64 = -1
    let msg: CString = CString(CPointer<UInt8>())
}

@C
struct FsInfo {
    let fd: FileHandle = InvalidHandle
    let msg: CString = CString(CPointer<UInt8>())
}
