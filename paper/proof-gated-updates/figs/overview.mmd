flowchart LR
    subgraph PRODUCER [" Untrusted: whoever produces the update "]
        direction TB
        P1["old version v1<br/>source + library"] --> PR
        P2["new version v2<br/>source (human, tool or model)"] --> PR
        I["intent<br/>changed functions, relations,<br/>migrations"] --> PR
        PR["prover (relational verifier<br/>+ contract and effect checks)"]
    end
    SMT1["Z3"]
    PR <-->|"obligations"| SMT1
    PR --> U["update = v2 library +<br/>certificate"]

    subgraph PROCESS [" Trusted: the running process "]
        direction TB
        CK["checker<br/>hashes, queries, affected set<br/>Z3 only"]
        QS["quiesce<br/>all tasks at safe points,<br/>no affected frame active"]
        SW["snapshot, link v2, migrate heap,<br/>repoint dispatch table"]
        WW["watch window<br/>fault, fuel, panic"]
        CK --> QS --> SW --> WW
    end
    SMT2["Z3"]
    CK <--> SMT2
    U ==> CK
    WW -->|"fault"| RB["roll back to snapshot<br/>and v1 code"]
    WW -->|"clean"| CM["committed"]

    classDef untrusted fill:#3b0764,stroke:#c084fc,color:#f8fafc,stroke-width:2px;
    classDef trusted fill:#064e3b,stroke:#34d399,color:#f8fafc,stroke-width:2px;
    classDef smt fill:#581c87,stroke:#e879f9,color:#f8fafc,stroke-width:2px;
    class PRODUCER untrusted;
    class PROCESS trusted;
    class SMT1,SMT2 smt;
    linkStyle default stroke:#64748b,stroke-width:1.5px;
