// TODO: This really ought to be defined in language-xcodegen
public enum Repo: CaseIterable, Sendable {
  case language
  case languageRuntimes
  case lldb
  case llvm
  case cmark

  public var relativePath: RelativePath {
    switch self {
    case .language: "language"
    case .languageRuntimes: "language/Runtimes"
    case .cmark: "cmark"
    case .lldb:  "llvm-project/lldb"
    case .llvm:  "llvm-project"
    }
  }

  public var buildDirPrefix: String? {
    switch self {
    case .language: "language"
    case .languageRuntimes: nil
    case .cmark: "cmark"
    case .lldb:  "lldb"
    case .llvm:  "llvm"
    }
  }
}
