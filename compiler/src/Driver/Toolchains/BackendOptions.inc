/**
 * @file
 *
 * This file lists library options to be passed to linker, which is included by headers.
 */

#ifdef CODENATIVE_STD_OPTIONS
// Must be linux.
CODENATIVE_STD_OPTIONS("-lcodira-runtime")
#endif

#ifdef CODENATIVE_DARWIN_BASIC_OPTIONS
CODENATIVE_DARWIN_BASIC_OPTIONS("-lboundscheck")
CODENATIVE_DARWIN_BASIC_OPTIONS("-lSystem")
#endif

#ifdef CODENATIVE_GNU_LINUX_BASIC_OPTIONS
CODENATIVE_GNU_LINUX_BASIC_OPTIONS("-lboundscheck")
