CODENATIVE_GNU_LINUX_BASIC_OPTIONS("-lc")
#endif

#ifdef CODENATIVE_STATIC_LINK_BASIC_OPTIONS
CODENATIVE_STATIC_LINK_BASIC_OPTIONS("-lstdc++")
