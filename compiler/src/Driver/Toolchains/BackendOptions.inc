#ifdef CODENATIVE_WINDOWS_BASIC_OPTIONS
#ifndef _MSC_VER
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lboundscheck")
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lm")
// libssp is used when stack protector related options is on, such as -fstack-protector-all.
// When linking statically, libssp_nonshared.a should be linked against first, then libssp.a.
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lmsvcrt")
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lmingw32")
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lmoldname")
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lmingwex")
// Don't delete the repeated libs below! The order below is same as the linker commands generated by MinGW gcc.
// It's intended to repeat linking them multiple times to resolve all symbols.
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lmingw32")
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lmsvcrt")
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lpthread")
CODENATIVE_WINDOWS_BASIC_OPTIONS("-ladvapi32")
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lshell32")
CODENATIVE_WINDOWS_BASIC_OPTIONS("-luser32")
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lkernel32")
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lmingw32")
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lmoldname")
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lmingwex")
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lmsvcrt")
#else
CODENATIVE_WINDOWS_BASIC_OPTIONS("-lmsvcrt")
#endif
#endif

