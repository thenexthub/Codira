import("//arkcompiler/ets_frontend/ets2panda/ets2abc_config.gni")
import("//arkcompiler/runtime_core/ark_config.gni")
import("$ark_root/tests/test_helper.gni")

test_ets_path = "$ark_root/guard/abckit_wrapper/tests/"

test_ets_files = [
  "ut/access_flag_test",
  "ut/annotation_test",
  "ut/class_hierarchy",
  "ut/field_test",
  "ut/method_param_test",
  "ut/module_static",
  "ut/set_name_test",
]

foreach(file, test_ets_files) {
  ets2abc_gen_abc("gen_${file}_abc") {
    test_ets = "${test_ets_path}${file}.ets"
    test_abc = "$target_out_dir/${file}.abc"

    # Only targets in this file can depend on this.
    extra_visibility = [ ":*" ]
    src_ets = rebase_path(test_ets)
    dst_file = rebase_path(test_abc)

    in_puts = [ test_ets ]
    out_puts = [ test_abc ]
  }
}

host_unittest_action("AbckitWrapperUnitTest") {
  module_out_path = "$ark_root"

  sources = [
    "ut/access_flag_test.cpp",
    "ut/annotation_test.cpp",
    "ut/class_hierarchy_test.cpp",
    "ut/field_test.cpp",
    "ut/file_view_test.cpp",
    "ut/hierarchy_dumper_test.cpp",
    "ut/logger_test.cpp",
    "ut/method_param_test.cpp",
    "ut/set_name_test.cpp",
    "ut/visitor_test.cpp",
  ]

  include_dirs = [
    "$ark_root/libabckit/include",
    "$ark_root/guard/abckit_wrapper/tests/util/include",
    "$ark_root/static_core",
    "$target_gen_dir/../../../static_core",
  ]

  configs = [
    "$ark_root/libabckit:abckit_config",
    "$ark_root/static_core/libarkbase:arkbase_public_config",
    "$ark_root/guard/abckit_wrapper:abckit_wrapper_public_config",
  ]

  deps = [
    "$ark_root/guard/abckit_wrapper:abckit_wrapper_shared",
    "$ark_root/static_core/libarkbase:libarktsbase",
  ]

  foreach(file, test_ets_files) {
    deps += [ ":gen_${file}_abc" ]
  }

  if (is_ohos && is_standard_system) {
    test_abc_dir = "/data/test"
  } else {
    test_abc_dir = rebase_path(target_out_dir)
  }

  defines = [ "ABCKIT_WRAPPER_ABC_FILE_DIR=\"${test_abc_dir}/\"" ]
}

group("host_unittest") {
  testonly = true
  deps = [ ":AbckitWrapperUnitTestAction" ]
}
