##################################hydra-fuzz###################################
import("//arkcompiler/toolchain/test/test_helper.gni")
import("//build/config/features.gni")
import("//build/ohos.gni")
import("//build/test.gni")

##################################fuzztest#####################################
ohos_fuzztest("PtTypesFunctionRemoteObjectFuzzTest") {
  module_out_path = toolchain_output_path

  fuzz_config_file =
      "//arkcompiler/toolchain/test/fuzztest/pttypesfunctionremoteobject_fuzzer"

  sources = [ "pttypesfunctionremoteobject_fuzzer.cpp" ]

  configs = [ "//arkcompiler/toolchain:toolchain_test_config" ]

  deps = [ "../../../tooling/dynamic:libark_ecma_debugger_set" ]

  # hiviewdfx libraries
  external_deps = hiviewdfx_ext_deps
  external_deps += [
    "cJSON:codeson",
    "ets_runtime:libark_jsruntime",
    "libuv:uv",
    sdk_libc_secshared_dep,
  ]
  deps += hiviewdfx_deps
}

group("fuzztest") {
  testonly = true
  deps = []
  deps += [ ":PtTypesFunctionRemoteObjectFuzzTest" ]
}
