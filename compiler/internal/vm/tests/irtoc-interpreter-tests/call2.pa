.function i32 foo(i32 a0, i32 a1) {
  add a0, a1
  return
}
.function i32 bar(i32 a0, i32 a1, i32 a2) {
  add a0, a1
  add2 a2
  return
}
.function i32 main() {
  movi v0, 7
  call.short foo, v0, v0
  sta v1
  call.range foo, v0
  sta v2
  call bar, v0, v1, v2
  addi -42
  return
}
