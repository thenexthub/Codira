// This file is used as the registry of sub-passes that are part of the
// SandboxVectorizer pass.
//
//===----------------------------------------------------------------------===//

// NOTE: NO INCLUDE GUARD DESIRED!

#ifndef REGION_PASS
#define REGION_PASS(NAME, CLASS_NAME)
#endif

REGION_PASS("null", ::toolchain::sandboxir::NullPass)
REGION_PASS("pack-reuse", ::toolchain::sandboxir::PackReuse)
REGION_PASS("print-instruction-count", ::toolchain::sandboxir::PrintInstructionCount)
REGION_PASS("print-region", ::toolchain::sandboxir::PrintRegion)
REGION_PASS("tr-save", ::toolchain::sandboxir::TransactionSave)
REGION_PASS("tr-accept", ::toolchain::sandboxir::TransactionAlwaysAccept)
REGION_PASS("tr-revert", ::toolchain::sandboxir::TransactionAlwaysRevert)
REGION_PASS("tr-accept-or-revert", ::toolchain::sandboxir::TransactionAcceptOrRevert)
REGION_PASS("bottom-up-vec", ::toolchain::sandboxir::BottomUpVec)

#undef REGION_PASS

#ifndef FUNCTION_PASS_WITH_PARAMS
#define FUNCTION_PASS_WITH_PARAMS(NAME, CLASS_NAME)
#endif

FUNCTION_PASS_WITH_PARAMS("seed-collection", ::toolchain::sandboxir::SeedCollection)
FUNCTION_PASS_WITH_PARAMS("regions-from-bbs", ::toolchain::sandboxir::RegionsFromBBs)
FUNCTION_PASS_WITH_PARAMS("regions-from-metadata", ::toolchain::sandboxir::RegionsFromMetadata)

#undef FUNCTION_PASS_WITH_PARAMS
