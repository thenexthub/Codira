import("//arkcompiler/runtime_core/static_core/ark_config.gni")
if (ark_standalone_build) {
  import("$build_root/ark.gni")
} else {
  import("//build/ohos.gni")
}

config("libarkfileExt_config") {
  include_dirs = [ "$ark_root" ]
}

ohos_shared_library("libarkfileExt") {
  sources = [ "$ark_root/libarkfile/external/file_ext.cpp" ]

  configs = [
    "$ark_root:ark_config",
    "$ark_root/libarkbase:arkbase_public_config",
    "$ark_root/libarkfile:arkfile_public_config",
    ":libarkfileExt_config",
  ]

  deps = [
    "$ark_root/libarkbase:libarktsbase",
    "$ark_root/libarkfile:libarktsfile",
  ]

  external_deps = [ sdk_libc_secshared_dep ]

  output_extension = "so"
  part_name = ark_part_name
  subsystem_name = "$ark_subsystem_name"
}

config("libarksupport_config") {
  include_dirs = [ "$ark_root" ]
}

ohos_shared_library("libarksupport") {
  sources = [ "$ark_root/libarkfile/external/panda_file_support.cpp" ]

  configs = [
    "$ark_root:ark_config",
    "$ark_root/libarkbase:arkbase_public_config",
    "$ark_root/libarkfile:arkfile_public_config",
    ":libarksupport_config",
  ]

  deps = [
    "$ark_root/libarkbase:libarktsbase",
    "$ark_root/libarkfile:libarktsfile",
  ]

  external_deps = [ sdk_libc_secshared_dep ]

  output_extension = "so"
  part_name = ark_part_name
  subsystem_name = "$ark_subsystem_name"
}
