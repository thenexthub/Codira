.record E1 {}

.function i32 f1() {
    newobj v0, E1
try_begin:
    throw v0
    ldai 2
    return
try_end:

catch_block1_begin:
    ldai 0
    return

catch_block2_begin:
    ldai 10
    return

.catch E1, try_begin, try_end, catch_block1_begin
.catchall try_begin, try_end, catch_block2_begin
}

.function i32 main() {
    call f1
    return
}