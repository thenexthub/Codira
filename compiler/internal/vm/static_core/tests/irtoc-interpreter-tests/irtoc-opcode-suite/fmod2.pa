.function i32 main() {
    fmovi v0, 18.5
    fmovi v1, 2.0
    fmovi v2, 0.0005
    fmovi v3, -0.5
    fmovi v4, -0.0005
    lda v0
    fmod2 v1
    fadd2 v3
    sta v0
    lda v2
    fcmpg v0
    sta v5
    lda v4
    fcmpl v0
    sta v6
    and v5, v6
    addi -1
    return
}
