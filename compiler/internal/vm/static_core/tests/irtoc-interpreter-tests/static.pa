.record Test {
    i32 n <static>
    u32[] a <static>
}

.function i32 main() {
    movi v1, 2
    newarr v0, v1, u32[]
    ldai 0x6
    movi v3, 0
    ldai 6
    starr v0, v3
    movi v3, 1
    ldai 7
    starr v0, v3
    lda.obj v0
    ststatic.obj Test.a
    ldai 50
    ststatic Test.n
    ldstatic.obj Test.a
    sta.obj v4
    lda v3
    ldarr v4
    sta v4
    ldstatic Test.n
    add2 v4
    addi -57
    return
}
