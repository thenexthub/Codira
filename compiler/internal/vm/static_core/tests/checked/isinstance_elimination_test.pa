#! CHECKER      IsInstance Elimination applied
#! RUN          force_jit: true, options: "--compiler-regex=_GLOBAL.*", entry: "_GLOBAL::main"
#! METHOD       "_GLOBAL::main"
#! PASS_AFTER   "TryCatchResolving"
#! INST_NOT     "IsInstance"

.record A1 {}
.record B1 <extends=A1> {}
.record C1 {}

.function u1 main() {
    newobj v0, B1
    lda.obj v0
    isinstance A1
    jeqz exit_failure

    newobj v0, C1
    lda.obj v0
    isinstance A1
    jnez exit_failure

    lda.null
    isinstance A1
    jnez exit_failure

    ldai 0
    return
exit_failure:
    ldai 1
    return
}