#! CHECKER      LLVM AOT inlines functions from other split modules
#! RUN_LLVM     options: "--llvmaot-methods-per-module=1 --llvm-dump-after"
#! READ_FILE    "console.out"
#! LLVM_METHOD  /define.*\"i32 _GLOBAL::main.*\d+\"/
#! RUN          entry: "_GLOBAL::main"

# Should inline foo into main even though foo and main are in different modules

.function i32 foo() {
    ldai 0
    return
}

.function i32 main() {
    call foo
    return
}

