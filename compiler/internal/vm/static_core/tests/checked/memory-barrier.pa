#! CHECKER      Constructor has memory barrier before return
#! RUN_PAOC     options: ""
#! METHOD       "Test::_ctor"
#! PASS_AFTER   "IrBuilder"
#! INST         "ReturnVoid F"

.record Test {
    i32 a <final>
}

.function void Test.init(Test a0) <ctor> {
    ldai 2
    stobj a0, Test.a
    return.void
}

