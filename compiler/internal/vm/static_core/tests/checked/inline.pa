#! INST_NOT     "StoreObject"
#! PASS_AFTER   "Inline"
#! INST         /CallVirtual.*A::setObj/
#! INST         "StoreObject"
#! METHOD       "Test4::func_A_getObj_wrong_virtual__noinline__"
#! PASS_AFTER   "IrBuilder"
#! INST         /CallVirtual.*A::getObj/
#! INST_NOT     "LoadObject"
#! PASS_AFTER   "Inline"
#! INST         /CallVirtual.*A::getObj/
#! INST         "LoadObject"
#! METHOD       "Test4::func_A_setObj_wrong_virtual__noinline__"
