# '--verification-mode=disabled' this option here is added to save test logic and remove verifier error
#! CHECKER      Interop interpreter rewrite index value
#! RUN          force_jit: true, options: "--verification-mode=disabled --compiler-regex=_GLOBAL::test", entry: "_GLOBAL::main", result: 1
#! EVENT        /Compilation,_GLOBAL::test,.*COMPILED/
#! METHOD       "_GLOBAL::test"

.function i64 test(i64[] a0, i32 a1) {
    lda a1
    ldarr.64 a0
    return.64
}

.function i64 main() {
    movi v0, 5
    newarr v1, v0, i64[]
    # v1 <- array

    ldai 1
    i32toi64
    movi.64 v3, 0
    starr.64 v1, v3

    movi v3, 1
    starr.64 v1, v3
    movi.64 v0, 0x7FFFFFFF00000001
    # Second parameter is 32-bit, but here we call it with 64-bit
    # don not change it #5353
    call.short test, v1, v0
    return.64
}
