/*---
desc: Abstract method implementation of a single interface.
---*/

let result: string = "";

interface Animal {
  makeSound(): void;
}

class Dog implements Animal {
  makeSound(): void {
    result = "woof";
  }
}

function main(): void {
  const dog = new Dog();
  dog.makeSound();
  arktest.assertEQ(result, "woof");
}