/*---
desc: Pass incomplete object literal to Required<Readonly> type with static public field, expect compile error
tags:
- negative
- compile-only
---*/

class A {
    public static a = 82;
    public b = 83;
    private c = 84;
}

function test(arg: Required<Readonly<A>>) {
}

function main(): void {
    test({});
}