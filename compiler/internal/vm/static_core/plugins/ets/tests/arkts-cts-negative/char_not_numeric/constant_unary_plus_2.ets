/*---
desc: Constant expression with unary plus as enum initializer.
name: constant_unary_plus_2
tags: []
---*/

const testValue: char = c'p'

function main() {
    enum TestEnum { One = +testValue }
    arktest.assertEQ(TestEnum.One.valueOf(), 112)
}
