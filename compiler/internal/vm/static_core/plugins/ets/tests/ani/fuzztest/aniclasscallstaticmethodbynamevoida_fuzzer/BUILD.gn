import("//arkcompiler/runtime_core/static_core/ark_root.gni")

#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
module_output_path = "arkcompiler/runtime_core/static_core/plugins/ets/ani"

##############################fuzztest##########################################
ohos_fuzztest("AniClassCallStaticMethodByNameVoidAFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file = "."
  include_dirs = [
    "../common",
    "$ark_root/plugins/ets/runtime/ani",
  ]
  configs = [ "$ark_root:ark_config" ]
  deps = [
    "$ark_root:ark_packages",
    "$ark_root/runtime:libarkruntime",
  ]
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  sources = [ "aniclasscallstaticmethodbynamevoida_fuzzer.cpp" ]
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    # deps file
    ":AniClassCallStaticMethodByNameVoidAFuzzTest",
  ]
}
###############################################################################
