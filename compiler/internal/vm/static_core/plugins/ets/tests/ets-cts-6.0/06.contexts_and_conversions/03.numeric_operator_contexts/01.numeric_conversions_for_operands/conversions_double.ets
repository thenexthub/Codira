{% for op in operators %}

/*---
desc: Widening numeric operands to the largest type.
---*/

function main(): void {
  let x: double = 1;
  let y: double = 1;
  arktest.assertEQ((x {{op[0]}} y), {{op[1]}})
  arktest.assertEQ((y {{op[0]}} x), {{op[1]}})
}

{% endfor %}
