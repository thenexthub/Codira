{% set cases = [
    {
        'enum_name': 'Color', 
        'enum_definition': '{ Red, Green, Blue }', 
        'test_value': 'Color.Red'
    },
    {
        'enum_name': 'Letter',
        'enum_definition': ':int { A = 1, B = 2, C = 3 }',
        'test_value': 'Letter.A'
    }
] %}

 {% from "16.concurrency/03.asynchronous_api/async_api_helper.jinja" import generate_async, call_async %}

 {% macro generate_complete_test(declaration_type='function') %}
 {% for c in cases %}

 /*---
 desc: The return type of an async {{declaration_type}} must be Promise<{{c.enum_name}}>.
 ---*/

enum {{c.enum_name}}{{c.enum_definition}}

{%- set params = {
    'name': 'noParams',
    'body': 'return ' + c.test_value,
    'return_type': ': Promise<' + c.enum_name + '>',
    'class_name': 'AsyncMethodReturnClass'
} %}

{{ generate_async(declaration_type, params) }}

async function startTest(){
    let result = {{ call_async(declaration_type, params) }}
    arktest.assertTrue(result instanceof Promise)
    let awaited_result = await result
    arktest.assertTrue(awaited_result instanceof {{c.enum_name}})
    arktest.assertEQ(awaited_result, {{c.test_value}})
}

function main(){
    waitForCompletion(startTest)
}

 {% endfor %}
 {% endmacro %}