.language eTS

.record A <ets.extends=std.core.Object, access.record=public> {}
.record B <ets.extends=A, access.record=public> {}
.record C <ets.extends=A, access.record=public> {}
.record D <ets.extends=std.core.Object, access.record=public> {}
.record std.core.Object <external>
.record {UB,C} <external>

.function void D._ctor_(D a0) <ctor, access.function=public> {
	return.void
}

.function void foo({UB,C}  a0) <static, access.function=public> {
	return.void
}

.function i32 main() <static, access.function=public> {
	initobj.short D._ctor_:(D)
	sta.obj v1
	call.short foo, v1
	ldai 1
	return
}
