.language eTS

.record Base <ets.extends=std.core.Object, access.record=public> {}
.record I <ets.abstract, ets.interface, ets.extends=std.core.Object, access.record=public> {}
.record A <ets.implements=I, ets.extends=Base, access.record=public> {}
.record BB <ets.extends=std.core.Object, access.record=public> {}
.record B <ets.extends=BB, access.record=public> {}
.record D <ets.extends=std.core.Object, access.record=public> {}
.record E <ets.extends=D, access.record=public> {}
.record std.core.Object <external>
.function void D.foo(D a0, A a1) <access.function=public> { return.void }
.function void E.foo(E a0, {UBase,I,B} a1) <access.function=public> { return.void }
.function void E.foo(E a0, I a1) <access.function=public> { return.void }
.function void E._ctor_(E a0) <ctor, access.function=public> {
	return.void
}
.function void Base._ctor_(Base a0) <ctor, access.function=public> {
	return.void
}
.function i32 main() <static, access.function=public> {
	initobj.short E._ctor_:(E)
	sta.obj v0
	initobj.short Base._ctor_:(Base)
	sta.obj v1
	call.virt.short E.foo:(E,{UBase,I,B}), v0, v1
	ldai 1
	return
}