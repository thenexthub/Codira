.language eTS

.record std.core.Object
.record A {
    i8 bar
    i8 baz
}
.record B {
    i8 bar
    i8 baz
}

.record %%union_prop-i8 {
    i8 bar
    i8 baz
}

.function i32 main() {
    newobj v0, A
    newobj v1, B
    movi v2, 15
    lda v2
    stobj v0, A.bar
    ldai 4
    ets.ldobj.name v0, %%union_prop-i8.bar
    movi v3, 5
    add2 v3
    movi v4, 20
    jne v4, error1
    stobj v1, B.baz
    ldai 2
    ets.ldobj.name v1, %%union_prop-i8.baz
    jne v4, error2
    ldai 0
    return
error1:
    ldai 1
    return
error2:
    ldai 2
    return
}
