import("//arkcompiler/runtime_core/platform/platform_config.gni")
import("//arkcompiler/runtime_core/tests/test_helper.gni")

host_unittest_action("PlatformTest") {
  module_out_path = "$platform_root"

  sources = [ "xgc_test.cpp" ]

  include_dirs = [ "$platform_root" ]

  configs = [ "$ark_root/platform:platform_public_config" ]

  deps = [ "$ark_root/platform:libplatform" ]
}

group("unittest") {
  testonly = true
  deps = [ ":PlatformTest" ]
}

group("host_unittest") {
  testonly = true
  deps = [ ":PlatformTestAction" ]
}
