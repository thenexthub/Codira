    }
    var d: Int32 = 2
}


class Right{
    var a:Int32 = 1
    var b:String = #"xyz\nxyz"#
    var c:String = """
    lmn\nlmn"""
    static func Monday(a:Int32,b:Int32):Int32{
        var m:Int32 = a*2
        var n:Int32 = b*2
        return Tuesday(m,b:a,a:b)
    }
    static func Tuesday(o:Int32,a!:Int32=2,b!:Int32=3):Int32{
        return o*100+a*10+b
    }

}



