main(): Int64 {
    return run()

}

func run(): Int64 {
   var day :Right = Right()
   print(Right.Monday(1,3).toString()) // 231
   return 0
}

class Wrong{
    var a:Int32 = 1
    var b:String = #"xyz\nxyz"#
    var c:String = """
    lmn\nlmn"""
    class Monday{
        var a:Int32 = 1
        func monday(a:Int32,b!:Int32=10):Int32{
            return a+b
        }
        class Tuesday{
             var a:Int32 =1
             func tuesday(a:Int32,b!:Int32=1):Int32{
                 return (a+b)*2
             }
             class Wednesday{
                 var a:Int32 =1
                 func wednesday(a:Int32,b!:Int32=1):Int32{
                     return (a+b)*3
                 }
                 class Thursday{
                     var a:Int32 =1
                     func thurday(a:Int32,b!:Int32=1):Int32{
                         return (a+b)*4
                     }
                     class Friday{
                         var a:Int32 =1
                         func friday(a:Int32,b!:Int32=1):Int32{
                             return (a+b)*5
                         }
