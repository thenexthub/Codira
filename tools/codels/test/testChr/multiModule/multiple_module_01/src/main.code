import pro1.yoo.*
import pro2.zoo

main(): Int64 {
    let a1 = aoo.one
    let a2 = aoo.
    let a3 = aoo.o
    let b1 = boo.two
    let e1 = xoo.x
    let f1 = yoo.y
    let g1 = zoo.z
    let res = a1 + b1
    let res2 = e1 + f1 + g1
