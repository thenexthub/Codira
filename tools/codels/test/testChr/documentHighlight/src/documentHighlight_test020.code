interface I20 {
    let aclass: int32 = 1
    func test_I20(a:int32):int32
}

class Base20 <: I20 {
    static var classa = 1
    static var Class = 2
	var a:int32 = 3
    init() {
        this.a = I20.aclass
    }
    init(a: int32) {
        this.a = a
    }

    func test_I20(a:int32):int32 {
        return a
    }
}

func test_Base20(){
    var value:Base20 =  Base20()
    var b = value.test_I20(100)
}

