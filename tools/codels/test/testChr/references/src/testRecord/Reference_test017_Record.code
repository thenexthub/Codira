package testRecord

struct Record1{
    let width1: Int32 = 10
    var length1: Int32 = 20

    init (width1: Int32, length1: Int32) {
        this.width1 = width1
        this.length1 = length1
    }
}

func test_struct() = {
    let a = Record1(1,1)
    a.width1 = 1
}
