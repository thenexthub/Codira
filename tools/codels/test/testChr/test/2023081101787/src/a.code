interface I1 {
    func h1(a: Rune) {}
}
class C12 <: I1 {
    func h1(a: Int64) {}
}

let m1: Int64 = 1
let m2 = C12()
let m3: Rune = 'a'

var m4 = m1 |> m2.h1
var m5 = m3 |> m2.h1

