package default

// enum的普通枚举值和函数形式的枚举值
enum TimeUnit {
    Year | Month | Day(Int32) | Hour(Int64)
}

enum TimeUnit1 {
    Year | Month | Day(Int32) | Hour(Int64)
}
func test1() {
    var time = TimeUnit.Day(3)
    var time2 = TimeUnit1.Hour(23)
    var res: Int32 = match (time) {
        case TimeUnit.Year => 0
        case Month => 1
        case Day(x) => 2
        case Hour(y) => 3

    }
    var res2: Int32 = match (time2) {
        case Y => 0
        case Month => 1
        case Day(x) => 2
        case Hour(y) => 3
    }
}

