interface Eq<TTTT> {

    func eq(other:TTTT): Bool

}

interface Ord<Tsss> where Tsss <: Eq<Tsss> {
    func lt(other: Tsss): Bool
}

func foo<ssss2s>(a: ssss2s) where ssss2s <: Ord< > {
    a.lt(a)
}

func foo2<ssss2s>(a: ssss2s) where ssss2s <: Ord<ssss2s> {
    a.
    a.lt(a)
}

