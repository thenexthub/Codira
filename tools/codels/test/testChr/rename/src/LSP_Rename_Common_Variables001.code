let def_var01:Int32 = 100

class Test001 {
	var a:Int32 = 3
    init(a: Int32) {
        this.a = a
    }

    func add(a: Int32, b: Int32):Int32 {
        return a + b + def_var01
    }
}

class Test0012 {
	var a:Int32 = 3
    init(a: Int32) {
        this.a = a
    }

    func add(a: Int32, b: Int32):Int32 {
        var def_var01_local:Int32 = 100
        return a + b + def_var01_local
    }
}
