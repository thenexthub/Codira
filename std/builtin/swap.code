// =============================================================================
// std/builtin/swap.code — Generic swap utility
// =============================================================================
//
// Provides generic swap functions for exchanging values without requiring
// explicit temporary variables.  Works with any Movable type.
//
//   let a: i32 = 1;
//   let b: i32 = 2;
//   swap(&a, &b);
//   // a == 2, b == 1
// =============================================================================

use std.builtin.traits;

// =============================================================================
// swap — Exchange two values via mutable references
// =============================================================================

// Exchange the values behind two mutable references.
//
// Both references must be valid and non-overlapping.
// Works with any type that satisfies Movable (which includes all value types).
//
// Example:
//   let x = 10;
//   let y = 20;
//   swap(&x, &y);
//   // x == 20, y == 10
public func swap[T](a: &T, b: &T) -> void {
    let tmp: T = *a;
    *a = *b;
    *b = tmp;
}

// =============================================================================
// swap_elements — Swap two elements inside a slice by index
// =============================================================================

// Swap elements at indices `i` and `j` within a mutable slice.
// Panics if either index is out of bounds.
//
// Example:
//   let arr = Array[i32].from(1, 2, 3);
//   swap_elements(arr.as_mut_slice(), 0, 2);
//   // arr is now [3, 2, 1]
public func swap_elements[T](data: Slice[T], i: usize, j: usize) -> void {
    if i >= data.len() {
        __panic("swap_elements: index i out of bounds");
    }
    if j >= data.len() {
        __panic("swap_elements: index j out of bounds");
    }
    if i == j {
        return;
    }
    let ptr = data.data();
    let tmp = ptr.offset(i as isize).read();
    ptr.offset(i as isize).write(ptr.offset(j as isize).read());
    ptr.offset(j as isize).write(tmp);
}

// =============================================================================
// swap_nonoverlapping — Bulk swap via pointers
// =============================================================================

// Swap `count` elements between two non-overlapping memory regions.
//
// The caller MUST guarantee that [a, a+count) and [b, b+count) do not
// overlap.  Behavior is undefined if they do.
public func swap_nonoverlapping[T](a: Pointer[T], b: Pointer[T], count: usize) -> void {
    let i: usize = 0;
    while i < count {
        let pa = a.offset(i as isize);
        let pb = b.offset(i as isize);
        let tmp = pa.read();
        pa.write(pb.read());
        pb.write(tmp);
        i = i + 1;
    }
}

// =============================================================================
// replace — Swap a value out and return the old one
// =============================================================================

// Write `new_value` into `dest` and return the previous value.
//
// Example:
//   let x: i32 = 42;
//   let old = replace(&x, 99);
//   // x == 99, old == 42
public func replace[T](dest: &T, new_value: T) -> T {
    let old: T = *dest;
    *dest = new_value;
    return old;
}

// =============================================================================
// take — Move a value out and leave the default in its place
// =============================================================================

// Move the value out of `src`, leaving `T::default()` behind.
// Requires T: Defaultable.
//
// Example:
//   let s = String.from("hello");
//   let taken = take(&s);
//   // taken == "hello", s == ""
public func take[T: Defaultable](src: &T) -> T {
    return replace[T](src, T.default());
}
