// =============================================================================
// std/builtin/tuple.code — Heterogeneous tuple types
// =============================================================================
//
// Tuples hold a fixed number of heterogeneously-typed elements.  Codira
// provides built-in tuple syntax `(A, B, C)`, but this module defines
// explicit struct wrappers (Tuple2 through Tuple8) that carry named
// accessors and trait implementations.
//
// All tuple structs are value types and satisfy Copyable when every
// element type is Copyable.
//
// Examples:
//   let pair = Tuple2[i32, String].new(42, "hello");
//   let a = pair.first();   // 42
//   let b = pair.second();  // "hello"
// =============================================================================

use std.builtin.traits;

// =============================================================================
// Tuple2 — pair
// =============================================================================

// A pair of two values of possibly different types.
public struct(value) Tuple2[A, B] {
    _0: A,
    _1: B,
}

public func Tuple2[A, B].new(a: A, b: B) -> Tuple2[A, B] {
    return Tuple2[A, B] { _0: a, _1: b };
}

public func Tuple2[A, B].first(self) -> A {
    return self._0;
}

public func Tuple2[A, B].second(self) -> B {
    return self._1;
}

public func Tuple2[A, B].swap(self) -> Tuple2[B, A] {
    return Tuple2[B, A] { _0: self._1, _1: self._0 };
}

public func Tuple2[A, B].map_first[C](self, f: func(A) -> C) -> Tuple2[C, B] {
    return Tuple2[C, B] { _0: f(self._0), _1: self._1 };
}

public func Tuple2[A, B].map_second[C](self, f: func(B) -> C) -> Tuple2[A, C] {
    return Tuple2[A, C] { _0: self._0, _1: f(self._1) };
}

public func Tuple2[A, B].to_string(self) -> String {
    return "("
        + __intrinsic_to_string(self._0)
        + ", "
        + __intrinsic_to_string(self._1)
        + ")";
}

public func Tuple2[A, B].eq(self, other: Tuple2[A, B]) -> bool {
    return self._0 == other._0 & self._1 == other._1;
}

public func Tuple2[A, B].ne(self, other: Tuple2[A, B]) -> bool {
    return !(self.eq(other));
}

public func Tuple2[A, B].copy(self) -> Tuple2[A, B] {
    return Tuple2[A, B] { _0: self._0, _1: self._1 };
}

public func Tuple2[A, B].hash(self, hasher: &Hasher) -> void {
    hasher.write(self._0);
    hasher.write(self._1);
}

// =============================================================================
// Tuple3 — triple
// =============================================================================

public struct(value) Tuple3[A, B, C] {
    _0: A,
    _1: B,
    _2: C,
}

public func Tuple3[A, B, C].new(a: A, b: B, c: C) -> Tuple3[A, B, C] {
    return Tuple3[A, B, C] { _0: a, _1: b, _2: c };
}

public func Tuple3[A, B, C].first(self) -> A { return self._0; }
public func Tuple3[A, B, C].second(self) -> B { return self._1; }
public func Tuple3[A, B, C].third(self) -> C { return self._2; }

public func Tuple3[A, B, C].to_string(self) -> String {
    return "("
        + __intrinsic_to_string(self._0) + ", "
        + __intrinsic_to_string(self._1) + ", "
        + __intrinsic_to_string(self._2)
        + ")";
}

public func Tuple3[A, B, C].eq(self, other: Tuple3[A, B, C]) -> bool {
    return self._0 == other._0 & self._1 == other._1 & self._2 == other._2;
}

public func Tuple3[A, B, C].copy(self) -> Tuple3[A, B, C] {
    return Tuple3[A, B, C] { _0: self._0, _1: self._1, _2: self._2 };
}

// =============================================================================
// Tuple4 — quadruple
// =============================================================================

public struct(value) Tuple4[A, B, C, D] {
    _0: A,
    _1: B,
    _2: C,
    _3: D,
}

public func Tuple4[A, B, C, D].new(a: A, b: B, c: C, d: D) -> Tuple4[A, B, C, D] {
    return Tuple4[A, B, C, D] { _0: a, _1: b, _2: c, _3: d };
}

public func Tuple4[A, B, C, D].first(self) -> A { return self._0; }
public func Tuple4[A, B, C, D].second(self) -> B { return self._1; }
public func Tuple4[A, B, C, D].third(self) -> C { return self._2; }
public func Tuple4[A, B, C, D].fourth(self) -> D { return self._3; }

public func Tuple4[A, B, C, D].to_string(self) -> String {
    return "("
        + __intrinsic_to_string(self._0) + ", "
        + __intrinsic_to_string(self._1) + ", "
        + __intrinsic_to_string(self._2) + ", "
        + __intrinsic_to_string(self._3)
        + ")";
}

public func Tuple4[A, B, C, D].eq(self, other: Tuple4[A, B, C, D]) -> bool {
    return self._0 == other._0 & self._1 == other._1
         & self._2 == other._2 & self._3 == other._3;
}

public func Tuple4[A, B, C, D].copy(self) -> Tuple4[A, B, C, D] {
    return Tuple4[A, B, C, D] { _0: self._0, _1: self._1, _2: self._2, _3: self._3 };
}

// =============================================================================
// Tuple5
// =============================================================================

public struct(value) Tuple5[A, B, C, D, E] {
    _0: A,
    _1: B,
    _2: C,
    _3: D,
    _4: E,
}

public func Tuple5[A, B, C, D, E].new(a: A, b: B, c: C, d: D, e: E) -> Tuple5[A, B, C, D, E] {
    return Tuple5[A, B, C, D, E] { _0: a, _1: b, _2: c, _3: d, _4: e };
}

public func Tuple5[A, B, C, D, E].first(self) -> A { return self._0; }
public func Tuple5[A, B, C, D, E].second(self) -> B { return self._1; }
public func Tuple5[A, B, C, D, E].third(self) -> C { return self._2; }
public func Tuple5[A, B, C, D, E].fourth(self) -> D { return self._3; }
public func Tuple5[A, B, C, D, E].fifth(self) -> E { return self._4; }

public func Tuple5[A, B, C, D, E].to_string(self) -> String {
    return "("
        + __intrinsic_to_string(self._0) + ", "
        + __intrinsic_to_string(self._1) + ", "
        + __intrinsic_to_string(self._2) + ", "
        + __intrinsic_to_string(self._3) + ", "
        + __intrinsic_to_string(self._4)
        + ")";
}

public func Tuple5[A, B, C, D, E].eq(self, other: Tuple5[A, B, C, D, E]) -> bool {
    return self._0 == other._0 & self._1 == other._1
         & self._2 == other._2 & self._3 == other._3
         & self._4 == other._4;
}

public func Tuple5[A, B, C, D, E].copy(self) -> Tuple5[A, B, C, D, E] {
    return Tuple5[A, B, C, D, E] {
        _0: self._0, _1: self._1, _2: self._2, _3: self._3, _4: self._4,
    };
}

// =============================================================================
// Tuple6
// =============================================================================

public struct(value) Tuple6[A, B, C, D, E, F] {
    _0: A,
    _1: B,
    _2: C,
    _3: D,
    _4: E,
    _5: F,
}

public func Tuple6[A, B, C, D, E, F].new(a: A, b: B, c: C, d: D, e: E, f: F) -> Tuple6[A, B, C, D, E, F] {
    return Tuple6[A, B, C, D, E, F] { _0: a, _1: b, _2: c, _3: d, _4: e, _5: f };
}

public func Tuple6[A, B, C, D, E, F].first(self) -> A { return self._0; }
public func Tuple6[A, B, C, D, E, F].second(self) -> B { return self._1; }
public func Tuple6[A, B, C, D, E, F].third(self) -> C { return self._2; }
public func Tuple6[A, B, C, D, E, F].fourth(self) -> D { return self._3; }
public func Tuple6[A, B, C, D, E, F].fifth(self) -> E { return self._4; }
public func Tuple6[A, B, C, D, E, F].sixth(self) -> F { return self._5; }

public func Tuple6[A, B, C, D, E, F].to_string(self) -> String {
    return "("
        + __intrinsic_to_string(self._0) + ", "
        + __intrinsic_to_string(self._1) + ", "
        + __intrinsic_to_string(self._2) + ", "
        + __intrinsic_to_string(self._3) + ", "
        + __intrinsic_to_string(self._4) + ", "
        + __intrinsic_to_string(self._5)
        + ")";
}

public func Tuple6[A, B, C, D, E, F].eq(self, other: Tuple6[A, B, C, D, E, F]) -> bool {
    return self._0 == other._0 & self._1 == other._1
         & self._2 == other._2 & self._3 == other._3
         & self._4 == other._4 & self._5 == other._5;
}

public func Tuple6[A, B, C, D, E, F].copy(self) -> Tuple6[A, B, C, D, E, F] {
    return Tuple6[A, B, C, D, E, F] {
        _0: self._0, _1: self._1, _2: self._2,
        _3: self._3, _4: self._4, _5: self._5,
    };
}

// =============================================================================
// Tuple7
// =============================================================================

public struct(value) Tuple7[A, B, C, D, E, F, G] {
    _0: A, _1: B, _2: C, _3: D, _4: E, _5: F, _6: G,
}

public func Tuple7[A, B, C, D, E, F, G].new(a: A, b: B, c: C, d: D, e: E, f: F, g: G) -> Tuple7[A, B, C, D, E, F, G] {
    return Tuple7[A, B, C, D, E, F, G] { _0: a, _1: b, _2: c, _3: d, _4: e, _5: f, _6: g };
}

public func Tuple7[A, B, C, D, E, F, G].to_string(self) -> String {
    return "("
        + __intrinsic_to_string(self._0) + ", "
        + __intrinsic_to_string(self._1) + ", "
        + __intrinsic_to_string(self._2) + ", "
        + __intrinsic_to_string(self._3) + ", "
        + __intrinsic_to_string(self._4) + ", "
        + __intrinsic_to_string(self._5) + ", "
        + __intrinsic_to_string(self._6)
        + ")";
}

// =============================================================================
// Tuple8
// =============================================================================

public struct(value) Tuple8[A, B, C, D, E, F, G, H] {
    _0: A, _1: B, _2: C, _3: D, _4: E, _5: F, _6: G, _7: H,
}

public func Tuple8[A, B, C, D, E, F, G, H].new(a: A, b: B, c: C, d: D, e: E, f: F, g: G, h: H) -> Tuple8[A, B, C, D, E, F, G, H] {
    return Tuple8[A, B, C, D, E, F, G, H] { _0: a, _1: b, _2: c, _3: d, _4: e, _5: f, _6: g, _7: h };
}

public func Tuple8[A, B, C, D, E, F, G, H].to_string(self) -> String {
    return "("
        + __intrinsic_to_string(self._0) + ", "
        + __intrinsic_to_string(self._1) + ", "
        + __intrinsic_to_string(self._2) + ", "
        + __intrinsic_to_string(self._3) + ", "
        + __intrinsic_to_string(self._4) + ", "
        + __intrinsic_to_string(self._5) + ", "
        + __intrinsic_to_string(self._6) + ", "
        + __intrinsic_to_string(self._7)
        + ")";
}

// =============================================================================
// Free-standing helpers
// =============================================================================

// Create a Tuple2 from positional arguments.
public func tuple(a: A, b: B) -> Tuple2[A, B] {
    return Tuple2[A, B].new(a, b);
}

// Create a Tuple3 from positional arguments.
public func tuple(a: A, b: B, c: C) -> Tuple3[A, B, C] {
    return Tuple3[A, B, C].new(a, b, c);
}

// Create a Tuple4 from positional arguments.
public func tuple(a: A, b: B, c: C, d: D) -> Tuple4[A, B, C, D] {
    return Tuple4[A, B, C, D].new(a, b, c, d);
}

// Zip two slices into an array of Tuple2 pairs.
// Stops at the shorter slice's length.
public func zip[A, B](a: Slice[A], b: Slice[B]) -> Array[Tuple2[A, B]] {
    let min_len = a.len();
    if b.len() < min_len {
        min_len = b.len();
    }
    let result = Array[Tuple2[A, B]].with_capacity(min_len);
    let i: usize = 0;
    while i < min_len {
        result.push(Tuple2[A, B].new(a.get(i), b.get(i)));
        i = i + 1;
    }
    return result;
}

// Unzip an array of Tuple2 into two separate arrays.
public func unzip[A, B](pairs: Slice[Tuple2[A, B]]) -> (Array[A], Array[B]) {
    let as_arr = Array[A].with_capacity(pairs.len());
    let bs_arr = Array[B].with_capacity(pairs.len());
    let i: usize = 0;
    while i < pairs.len() {
        let p = pairs.get(i);
        as_arr.push(p.first());
        bs_arr.push(p.second());
        i = i + 1;
    }
    return (as_arr, bs_arr);
}
